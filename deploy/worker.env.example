# Copy to /etc/xcloud/worker.env on an existing dedicated host, mode 0600, root-owned.
# Set a dedicated worker token privately on both this host and the coordinator.
PLATFORM_COORDINATOR_URL=https://x-cloud-workbench.onrender.com
PLATFORM_SANDBOX_IMAGE=xcloud-java21-runner:1
PLATFORM_WORKER_TOKEN=replace-with-a-private-worker-token-of-at-least-32-characters

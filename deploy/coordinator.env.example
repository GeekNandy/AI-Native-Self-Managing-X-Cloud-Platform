# Copy to /etc/xcloud/coordinator-NAME.env with mode 0600; provide values privately.
# Each instance requires its own state directory (provided by the service unit).
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_DB:5432/workbench
PLATFORM_COORDINATOR_MODE=lease
PLATFORM_COORDINATOR_LEASE_SECONDS=30
PLATFORM_COORDINATOR_ACQUIRE_TIMEOUT_SECONDS=60
PLATFORM_RUNTIME=sandbox
PLATFORM_EXECUTION_MODE=remote
GITHUB_PUBLISH_REPOSITORY=
PLATFORM_OPERATOR_TOKEN=REPLACE_WITH_SHARED_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
PLATFORM_AGENT_TOKEN=REPLACE_WITH_A_DISTINCT_SHARED_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
PLATFORM_WORKER_TOKEN=REPLACE_WITH_A_DISTINCT_SHARED_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
# Local reverse proxy or readiness-aware router terminates TLS and forwards traffic.
SERVER_ADDRESS=127.0.0.1
PORT=8080
# Hosted access requires an exact HTTPS origin plus private username/password settings.

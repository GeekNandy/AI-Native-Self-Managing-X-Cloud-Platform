{
  "inputs": [
    {
      "type": "promptString",
      "id": "xcloud-agent-token",
      "description": "X Cloud proposal-only agent token",
      "password": true
    }
  ],
  "servers": {
    "x-cloud-workbench": {
      "type": "http",
